generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum AttendanceType {
  PRESENTIAL_QR
  PRESENTIAL_NFC
  BIOMETRIC_FINGERPRINT
  FACIAL_RECOGNITION
  HOME_OFFICE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  WEEKEND_REST
  HOLIDAY
}

enum PermissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionType {
  MEDICAL_LEAVE       // Descanso Médico (ESSALUD)
  PERSONAL_PERMIT     // Papeleta de Salida Particular
  MATERNITY_PATERNITY // Licencia Maternidad/Paternidad
  VACATION_LEAVE      // Saldo de Vacaciones
  COMMISSION          // Comisión de Servicio Externo
}

model Company {
  id              String          @id @default(uuid())
  name            String          @default("Hyperion Digital Security S.A.C.") // Razón Social exigida por SUNAFIL
  ruc             String          @unique @default("20608810987")             // RUC de 11 dígitos obligatorio
  officeLat       Float           @default(-14.078775)
  officeLng       Float           @default(-75.751176)
  radiusM         Float           @default(30.0)
  qrSecret        String          @default("HYPERION_QR_SECRET_KEY_2026")
  users           User[]
  payrollPolicies PayrollPolicy[]
  createdAt       DateTime        @default(now())
}

model User {
  id               String   @id @default(uuid())
  dni              String   @unique
  docType          String   @default("DNI")
  name             String
  lastName         String
  email            String   @unique
  passwordHash     String
  role             Role     @default(EMPLOYEE)
  jobTitle         String
  workStartTime    String   @default("09:00")
  toleranceMinutes Int      @default(10)
  homeOfficeQuota  Int      @default(4)
  baseSalary       Float    @default(0.0)
  discountRate     Float    @default(0.0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  payrollPolicyId String?
  payrollPolicy   PayrollPolicy? @relation(fields: [payrollPolicyId], references: [id])

  homeAddresses      HomeAddress[]
  attendanceRecords  AttendanceRecord[]
  auditLogs          AuditLog[]
  permissionsRequest PermissionRequest[]
  digitalPaystubs    DigitalPaystub[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeAddress {
  id        String   @id @default(uuid())
  alias     String   @default("Casa Principal")
  latitude  Float
  longitude Float
  address   String?
  isPrimary Boolean  @default(true)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AttendanceRecord {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id])
  date                 DateTime         @db.Date
  checkIn              DateTime?
  lunchStart           DateTime?
  lunchEnd             DateTime?
  checkOut             DateTime?
  type                 AttendanceType   @default(PRESENTIAL_QR)
  status               AttendanceStatus @default(PRESENT)

  lateMinutes          Int              @default(0)

  // CUMPLIMIENTO LEY N° 28999: SOBRETASAS DE HORAS EXTRAS (25% Y 35%)
  overtimeMinutes      Int              @default(0)
  overtime25Minutes    Int              @default(0)
  overtime35Minutes    Int              @default(0)
  isOvertimeApproved   Boolean          @default(false)
  approvedBy           String?

  // TRANSPARENCIA LABORAL D.S. N° 004-2006-TR
  isModifiedByHR       Boolean          @default(false)
  hrModificationReason String?          @db.Text

  latitude             Float
  longitude            Float
  employeeSignature    String?
  observations         String?
  createdAt            DateTime         @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  entity        String
  entityId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  reason        String   @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())
}

model PermissionRequest {
  id                String           @id @default(uuid())
  userId            String
  type              PermissionType   @default(PERSONAL_PERMIT)
  reason            String           @db.Text
  startDate         DateTime
  endDate           DateTime
  status            PermissionStatus @default(PENDING)
  approvedBy        String?
  employeeSignature String?          @db.Text // Trazo de firma táctil (PNG Base64)
  signedPdfBase64   String?          @db.Text // PDF firmado con Certificado Camercloud PAdES-B
  signatureCode     String?          @db.Text // 👈 CÓDIGO DE FIRMA DEVUELTO POR CAMERCLOUD
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SstRecord {
  id           String   @id @default(uuid())
  companyId    String
  title        String   // Ej: "Capacitación Anual N° 1 - Primeros Auxilios"
  type         String   // CAPACITACION, ENTREGA_EPP, INCIDENTE
  date         DateTime @db.Date
  participants Int      @default(0)
  documentUrl  String?  // Evidencia PDF o Acta con Firma
  createdAt    DateTime @default(now())
}

model DigitalPaystub {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  period           String    // Ej: "2026-09"
  fileUrl          String    // URL de la boleta en PDF
  isEmployerSigned Boolean   @default(false)
  isEmployeeSigned Boolean   @default(false)
  signedAt         DateTime?
  createdAt        DateTime  @default(now())
}

model PayrollPolicy {
  id                      String   @id @default(uuid())
  name                    String   @default("Régimen General 728")
  daysInMonth             Int      @default(30)   // Divisor de días laborables (30)
  hoursPerDay             Float    @default(8.0)  // Horas por jornada ordinaria (8)

  overtimeFirst2HoursRate Float    @default(1.25) // Recargo primer tramo (25%)
  overtimeNextHoursRate   Float    @default(1.35) // Recargo segundo tramo (35%)

  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id])
  users                   User[]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}